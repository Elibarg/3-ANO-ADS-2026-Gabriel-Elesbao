# ============================================================
# DOCKERFILE — Frontend Vue.js com Multi-Stage Build
# Desafio 2 | Módulo 10 | Trilha de Docker | UniSENAI 2026
# ============================================================
# Por que Multi-Stage Build para o Vue?
#
# O Vue precisa de Node.js + npm para COMPILAR o projeto (npm run build),
# mas o resultado final é apenas HTML, CSS e JS estáticos — o Node.js
# não é mais necessário depois. O Multi-Stage Build resolve isso:
#   Estágio 1: Node.js (pesado) → compila o projeto Vue
#   Estágio 2: Nginx (leve) → serve apenas os arquivos compilados
#
# Resultado: imagem final ~20MB em vez de ~400MB com Node incluído

# ── ESTÁGIO 1: Build do Vue ──────────────────────────────────
# AS build → nomeia o estágio para referência posterior
FROM node:18-alpine AS build

WORKDIR /app

# Copia dependências primeiro (cache de camadas do Docker)
# Se package.json não mudar, npm install é ignorado nos próximos builds
COPY package*.json ./

# npm ci → instalação limpa e reproduzível baseada no package-lock.json
# Mais adequado que "npm install" para ambientes de build/CI
RUN npm ci

# Copia o código-fonte Vue (src/, public/, vite.config.js, etc.)
COPY . .

# npm run build → executa o script de build definido no package.json
# O Vite/Vue CLI compila o projeto e gera a pasta dist/ com:
#   dist/index.html    → página principal
#   dist/assets/*.js   → JavaScript compilado e minificado
#   dist/assets/*.css  → CSS compilado e minificado
RUN npm run build

# ── ESTÁGIO 2: Imagem final com Nginx ───────────────────────
# Começa do zero com Nginx — não carrega Node.js, npm ou código-fonte
FROM nginx:alpine

# COPY --from=build → copia apenas a pasta dist/ do estágio anterior
# /app/dist           → onde o Vue gerou os arquivos compilados
# /usr/share/nginx/html → pasta padrão onde o Nginx serve arquivos estáticos
COPY --from=build /app/dist /usr/share/nginx/html

# Copia configuração do Nginx customizada (se necessário para rotas Vue)
# O Vue Router em modo history precisa que todas as rotas caiam no index.html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# CMD do Nginx: -g "daemon off" → roda em primeiro plano (necessário no Docker)
# Sem isso, o Nginx vai para background e o contêiner encerra imediatamente
CMD ["nginx", "-g", "daemon off;"]
