{
  "openapi": "3.0.0",
  "info": {
    "title": "API Usuários",
    "version": "1.0.0",
    "description": "Documentação da API REST desenvolvida na Trilha Node.js"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "paths": {
    "/usuarios": {
      "get": {
        "summary": "Lista usuários",
        "responses": {
          "200": {
            "description": "Lista retornada com sucesso"
          }
        }
      },
      "post": {
        "summary": "Cria usuário",
        "responses": {
          "201": {
            "description": "Usuário criado"
          }
        }
      }
    },
    "/usuarios/{id}": {
      "put": {
        "summary": "Atualiza usuário",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário atualizado"
          }
        }
      },
      "delete": {
        "summary": "Remove usuário",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário removido"
          }
        }
      }
    }
  }
}