<div class="card">

<h1>Cadastrar Usuário</h1>

<% if (erro) { %>

<div class="erro">

<%= erro %>

</div>

<% } %>

<form action="/usuarios/novo" method="POST">

<label>Nome</label>

<input
type="text"
name="nome"
value="<%= usuario.nome || '' %>">

<label>Email</label>

<input
type="email"
name="email"
value="<%= usuario.email || '' %>">

<label>Senha</label>

<input
type="password"
name="senha">

<button>

Cadastrar

</button>

</form>

</div>