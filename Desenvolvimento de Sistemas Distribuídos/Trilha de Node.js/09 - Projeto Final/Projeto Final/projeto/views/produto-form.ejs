<div class="card">

<h1>Novo Produto</h1>

<form
action="/produtos/novo"
method="POST">

<label>

Nome

</label>

<input
type="text"
name="nome">

<label>

Categoria

</label>

<input
type="text"
name="categoria">

<label>

Quantidade

</label>

<input
type="number"
name="quantidade">

<label>

Preço

</label>

<input
type="number"
step="0.01"
name="preco">

<button>

Salvar

</button>

</form>

</div>