<div class="card">

<h1>

Produtos com Estoque Baixo

</h1>

<table>

<thead>

<tr>

<th>ID</th>

<th>Produto</th>

<th>Categoria</th>

<th>Quantidade</th>

</tr>

</thead>

<tbody>

<% produtos.forEach(produto => { %>

<tr>

<td><%= produto.id %></td>

<td><%= produto.nome %></td>

<td><%= produto.categoria %></td>

<td><%= produto.quantidade %></td>

</tr>

<% }) %>

</tbody>

</table>

</div>