<div class="card">

<h1>

Produtos Mais Movimentados

</h1>

<table>

<thead>

<tr>

<th>ID</th>

<th>Produto</th>

<th>Total Movimentado</th>

</tr>

</thead>

<tbody>

<% produtos.forEach(produto => { %>

<tr>

<td><%= produto.id %></td>

<td><%= produto.nome %></td>

<td><%= produto.total %></td>

</tr>

<% }) %>

</tbody>

</table>

</div>