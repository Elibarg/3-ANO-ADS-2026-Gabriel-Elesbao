<div class="card">

    <h1>Cadastrar Usuário</h1>

    <% if (erro) { %>

        <div class="erro">

            <%= erro %>

        </div>

    <% } %>

    <form action="/usuarios/novo" method="POST">

        <label>

            Nome

        </label>

        <input
            type="text"
            name="nome"
            value="<%= nome %>"
            placeholder="Digite o nome">

        <button>

            Salvar

        </button>

    </form>

</div>