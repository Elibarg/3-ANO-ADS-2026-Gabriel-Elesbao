<div class="card">

    <h1>Usuários Cadastrados</h1>

    <a class="botao" href="/usuarios/novo">

        Novo Usuário

    </a>

    <table>

        <thead>

            <tr>

                <th>ID</th>

                <th>Nome</th>

            </tr>

        </thead>

        <tbody>

            <% usuarios.forEach(usuario => { %>

                <tr>

                    <td><%= usuario.id %></td>

                    <td><%= usuario.nome %></td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</div>